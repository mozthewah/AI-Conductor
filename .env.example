# Copy to .env and fill in. Or run `ant auth login` and skip the key entirely.
ANTHROPIC_API_KEY=

# Optional overrides
CONDUCTOR_MODEL=claude-opus-5-5
CONDUCTOR_EFFORT=high            # low | medium | high | xhigh | max
CONDUCTOR_APPROVAL=ask           # ask = confirm shell/browser actions, auto = just do it
CONDUCTOR_DATA_DIR=./data
CONDUCTOR_WORKSPACE=./workspace
CONDUCTOR_LEARNING=on            # reflect after each task and save memories/skills
CONDUCTOR_WEB_TOOLS=on           # Anthropic-hosted web search + fetch
CONDUCTOR_BROWSER=on             # local Playwright browser ("computer" view)
