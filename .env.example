# --- Model providers (set at least one) -------------------------------------
# OpenRouter: one key for hundreds of models (Claude, GPT, Gemini, DeepSeek, ...)
OPENROUTER_API_KEY=
# Optional: an OpenRouter *management* key (read-only use) lets Conductor see your account balance,
# your own provider keys (BYOK), the guardrail on your key, and 30-day spend per model
OPENROUTER_MANAGEMENT_KEY=
CONDUCTOR_CREDIT_LOW=2           # USD; below this it warns and leans on cheaper models
CONDUCTOR_BYOK=auto              # auto: use your own provider keys when credits run low/out | prefer | off
CONDUCTOR_CLAUDE_CLI=fallback    # Claude Code on your Claude subscription: fallback | prefer | off
CONDUCTOR_HEADROOM=auto          # compress bulky tool output with Headroom (pip install headroom-ai): auto | on | off
CONDUCTOR_HEADROOM_PROXY=auto    # send the Claude Code fallback through Headroom's proxy if it's running: auto | off | URL
# CONDUCTOR_CLAUDE_PATH=         # path to the `claude` CLI if it isn't on PATH
# CONDUCTOR_KEY_NAME=            # your API key's name on openrouter.ai, if `conductor doctor` can't match it
# Anthropic direct (optional): Claude models straight from Anthropic
ANTHROPIC_API_KEY=

# --- Model choice -------------------------------------------------------------
CONDUCTOR_MODEL=auto             # auto = router picks per task, or pin e.g. openai/gpt-6.1-sol
CONDUCTOR_BUDGET=balanced        # frugal | balanced | best  (how much the router weighs cost)
CONDUCTOR_COMPOSE=auto           # auto: compose anything beyond quick questions | always | off
CONDUCTOR_COMPOSER_HANDS=off     # off: the composer must delegate all hands-on work to specialists
CONDUCTOR_LEAD_BUDGET=best       # the conductor that splits, reviews, and integrates big requests
CONDUCTOR_PART_BUDGET=best       # core parts go to the best model for that kind of work
CONDUCTOR_SUBAGENT_BUDGET=frugal # supporting parts (lookups, reading) lean cheap
CONDUCTOR_SUBAGENT_MODEL=auto    # or pin every specialist to one model
CONDUCTOR_ROUTER_MODEL=          # the classifier; default anthropic/claude-haiku-5.5
CONDUCTOR_EXPLORE=0.1            # share of tasks where the router tries a less-proven model
CONDUCTOR_AUTO_ESCALATE=on       # move up to a stronger model when a task grows or the model struggles
CONDUCTOR_EXPERT_MODEL=auto      # who consult_expert asks for advice
CONDUCTOR_EFFORT=high            # low | medium | high | xhigh | max (reasoning models)

# --- Behavior -----------------------------------------------------------------
CONDUCTOR_APPROVAL=low           # auto-approve up to: safe | low | medium | high (critical always asks)
CONDUCTOR_UNATTENDED_APPROVAL=low  # scheduled runs: anything above this is declined
CONDUCTOR_LEARNING=on            # reflect after each task and save memories/skills
CONDUCTOR_WEB_TOOLS=on           # hosted web search + fetch (works with every model)
CONDUCTOR_BROWSER=on             # local Playwright browser ("computer" view)
CONDUCTOR_AUDIT=on               # local audit log: data/logs/audit-YYYY-MM-DD.jsonl
CONDUCTOR_DATA_DIR=./data
CONDUCTOR_WORKSPACE=./workspace

# --- Other devices (phone, tablet) -------------------------------------------
# CONDUCTOR_HOST=0.0.0.0         # reachable on your Wi-Fi (same as `conductor serve --lan`); passcode-protected
# CONDUCTOR_PORT=8765
# CONDUCTOR_STAY_AWAKE=on        # keep the computer from sleeping while Conductor runs
# CONDUCTOR_ACCESS_TOKEN=        # passcode for other devices (default: generated into data/access_token)
